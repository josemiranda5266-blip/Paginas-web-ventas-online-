# ==============================================================================
# PAGINAS WEB VENTAS ONLINE - PLATAFORMA SAAS E-COMMERCE MULTI-TENANT
# ==============================================================================
# Guía y Declaración de Variables de Entorno
# ------------------------------------------------------------------------------
# Este archivo contiene todas las variables de entorno necesarias para el funcionamiento
# de la plataforma. Ninguna clave sensible debe ser enviada al frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIABLES BÁSICAS DE ENTORNO (Obligatorias para Desarrollo y Servidor)
# ------------------------------------------------------------------------------
# Puerto donde corre el servidor unificado Express + Vite
PORT=3000

# Entorno de ejecución: 'development' | 'production'
NODE_ENV=development

# URL base pública de la aplicación
# En desarrollo: http://localhost:3000
# En producción: https://tudominio.com
APP_URL=http://localhost:3000

# Clave secreta para firmar y validar tokens de sesión JWT
# Origen: Cadena aleatoria segura generada para tu aplicación
JWT_SECRET=clave_secreta_jwt_para_desarrollo_local_12345

# Clave de 32 bytes para encriptar tokens de Mercado Pago OAuth en la base de datos (AES-256-GCM)
# Origen: Cadena aleatoria de 32 caracteres o hash de seguridad
ENCRYPTION_KEY=clave_de_32_bytes_para_cifrado_aes_seguro_!!


# ------------------------------------------------------------------------------
# 2. INTEGRACIÓN MERCADO PAGO - APLICACIÓN INTEGRADORA (OAuth Multi-Vendedor)
# ------------------------------------------------------------------------------
# IMPORTANTE:
# Nuestra cuenta de Mercado Pago actúa EXCLUSIVAMENTE como la APLICACIÓN INTEGRADORA.
# NUNCA recibe los pagos de las ventas de los comercios.
# Cada comercio vincula su propia cuenta mediante OAuth y recibe sus ventas directamente.
#
# Para obtener estas credenciales:
# 1. Ingresar a https://www.mercadopago.com/developers/panel/app
# 2. Crear una nueva aplicación (ej: "Paginas Web Ventas Online SaaS").
# 3. En "Detalles de la aplicación", obtener 'Client ID' y 'Client Secret'.
# 4. En "Configuración OAuth", registrar la Redirect URI:
#    http://localhost:3000/api/payments/mercadopago/oauth/callback (desarrollo)
#    https://tudominio.com/api/payments/mercadopago/oauth/callback (producción)
# 5. En "Notificaciones Webhooks", configurar el endpoint:
#    https://tudominio.com/api/payments/mercadopago/webhook y obtener la clave de firma.

# ID de la aplicación de Mercado Pago (Client ID)
MP_APP_CLIENT_ID=

# Clave secreta de la aplicación de Mercado Pago (Client Secret)
# ¡NUNCA exponer en el frontend!
MP_APP_CLIENT_SECRET=

# URI de redireccionamiento para el callback de autorización OAuth
MP_OAUTH_REDIRECT_URI=http://localhost:3000/api/payments/mercadopago/oauth/callback

# Clave secreta para validar la firma criptográfica HMAC-SHA256 de los Webhooks de Mercado Pago
# Header 'x-signature' enviado por Mercado Pago
MP_WEBHOOK_SECRET=


# ------------------------------------------------------------------------------
# 3. BASE DE DATOS POSTGRESQL (Para Producción / Prisma ORM)
# ------------------------------------------------------------------------------
# Cadena de conexión estándar para PostgreSQL.
# En desarrollo local el proyecto incluye un almacén multi-tenant con persistencia en memoria
# para arrancar sin necesidad de un servidor PostgreSQL externo inmediato.
# En producción, configurar la URL de tu base de datos PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/paginas_web_ventas_online?schema=public"
